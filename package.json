{
  "name": "cv-online",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "sync:projects": "node scripts/sync-projects.mjs",
    "predev": "npm run content",
    "dev": "vite",
    "prebuild": "npm run content",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/verify-dist.mjs",
    "pdf": "node scripts/pdf.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "npm run content",
    "test": "vitest run",
    "test:py": "python -m unittest discover importers/tests",
    "import:linkedin": "python importers/linkedin_zip.py",
    "scrape": "python ./scraper/scrape_and_copy.py"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
